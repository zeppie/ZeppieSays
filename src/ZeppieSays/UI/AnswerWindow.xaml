<Window x:Class="ZeppieSays.UI.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="Height" Width="580" ThemeMode="None"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- The same fixed dark look as the pill, so it reads over any app, light or dark. -->
    <Window.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#26FFFFFF" CornerRadius="7" Padding="11,5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Padding="18,14,18,14" Margin="16"
            Background="#F216161C" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.4" />
        </Border.Effect>
        <DockPanel>
            <!-- The question, and a way to close -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="#7C5CFF" CornerRadius="6" Padding="7,1" VerticalAlignment="Top" Margin="0,1,10,0">
                    <TextBlock x:Name="KeyLabel" Text="Ask" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="Question" Grid.Column="1" Foreground="#B3FFFFFF" FontSize="13" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource CardButton}" Margin="10,0,0,0" VerticalAlignment="Top" Padding="0"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="Close_Click" />
            </Grid>

            <!-- Copy, paste, and which model answered -->
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource CardButton}" Click="Copy_Click" IsEnabled="False" />
                <Button x:Name="PasteButton" Grid.Column="1" Content="Paste at cursor" Style="{StaticResource CardButton}" Margin="8,0,0,0"
                        Click="Paste_Click" IsEnabled="False" ToolTip="Types the answer where your cursor was, without the formatting" />
                <TextBlock x:Name="ModelLabel" Grid.Column="2" Foreground="#80FFFFFF" FontSize="11" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
            </Grid>

            <!-- Where it looked -->
            <WrapPanel x:Name="Sources" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

            <!-- The answer, streaming in -->
            <StackPanel>
                <TextBlock x:Name="Status" Foreground="#B9A8FF" FontSize="13" Margin="0,0,0,6" />
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                    <StackPanel x:Name="Answer" />
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
