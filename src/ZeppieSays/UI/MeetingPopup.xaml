<Window x:Class="ZeppieSays.UI.MeetingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeppie Says meeting" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <!-- A card in the corner of the screen: first "Record this meeting?", then the running recording. -->
    <Border Margin="12" CornerRadius="14" Padding="18,16" MouseLeftButtonDown="Card_MouseLeftButtonDown"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <!-- Ask -->
            <StackPanel x:Name="AskPanel">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/zeppie.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="AskTitle" Text="Teams is using your microphone" FontWeight="SemiBold" FontSize="14"
                               Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="Record this meeting? Zeppie Says writes the transcript and notes afterwards, on this PC."
                           TextWrapping="Wrap" FontSize="13" Margin="0,10,0,6" />
                <TextBlock Text="Let the others know you're recording." TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Not now" Click="NotNow_Click" MinWidth="84" />
                    <Button Content="Record" Click="Record_Click" MinWidth="84" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Recording -->
            <Grid x:Name="RecordingPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#E5484D" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="RecordingTitle" Text="Recording Teams meeting" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Timer" Text="0:00" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Stop" Click="Stop_Click" MinWidth="72" VerticalAlignment="Center" />
            </Grid>

            <!-- Saved -->
            <StackPanel x:Name="SavedPanel" Visibility="Collapsed" Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#7C5CFF"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SavedText" Text="Recording saved. Transcribing in Notetaker…" FontSize="13" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
