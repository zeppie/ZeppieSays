<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target gives access to Windows.Media.Ocr for local screen context. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\zeppie.ico</ApplicationIcon>
    <AssemblyName>ZeppieSays</AssemblyName>
    <Product>ZeppieSays</Product>
    <Version>0.1.0</Version>
    <!-- Our own Main, so Velopack's install/update hooks run before WPF starts. -->
    <StartupObject>ZeppieSays.App</StartupObject>
    <!-- WPF Fluent theme (ThemeMode) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon and screen info; keep its namespaces out of global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Whisper.net ships native libraries for every platform; the installer only needs Windows x64 (the Linux CUDA one alone is 390 MB). -->
  <Target Name="DropOtherPlatformRuntimes" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes\cuda\linux-x64;$(PublishDir)runtimes\win-arm64;$(PublishDir)runtimes\win-x86" />
  </Target>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\zeppie.ico" />
    <Resource Include="Assets\zeppie.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.1.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.8.1" />
  </ItemGroup>

</Project>
