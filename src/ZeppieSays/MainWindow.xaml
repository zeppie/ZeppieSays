<Window x:Class="ZeppieSays.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZeppieSays.UI"
        xmlns:core="clr-namespace:ZeppieSays.Core"
        xmlns:notes="clr-namespace:ZeppieSays.Notes"
        xmlns:services="clr-namespace:ZeppieSays.Services"
        Title="ZeppieSays" Width="1180" Height="800" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/zeppie.ico"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <!-- The sidebar runs up into the title bar; the caption buttons are drawn by us. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <ui:EmptyToVisibleConverter x:Key="EmptyToVisible" />
        <!-- Advanced speaker detection: in Settings for every new file, and per file before it starts -->
        <DataTemplate x:Key="SpeakerDetectionPanel" DataType="{x:Type ui:SpeakerSettingsViewModel}">
            <StackPanel>
                <TextBlock Text="Same-voice threshold" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="More speakers" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0.2" Maximum="0.95" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" Value="{Binding Threshold}" Margin="10,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Same-voice threshold" />
                    <TextBlock Grid.Column="2" Text="Fewer speakers" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                    <Run Text="{Binding ThresholdText, Mode=OneWay}" />
                    <Hyperlink Command="{Binding ResetThreshold}"><Hyperlink.Style>
                        <Style TargetType="Hyperlink">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCustomThreshold}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Hyperlink.Style><Run Text=" · back to default" /></Hyperlink>
                </TextBlock>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap"
                           Text="How different two voices must sound to count as two people. Two people on one microphone sound alike: move left. One person split into several: move right. Not used when you pick the number of people." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Minimum speech per speaker" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static ui:SpeakerSettingsViewModel.MinSpeechChoices}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding MinSpeech}"
                                  ToolTip="A 'speaker' with less speech is taken to be a fragment (a laugh, a 'yes') of someone else and merged into them. Not used when you pick the number of people." />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Shortest speech" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static ui:SpeakerSettingsViewModel.ShortestSpeechChoices}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding ShortestSpeech}" MinWidth="110"
                                  ToolTip="Speech shorter than this is ignored by the detection. Lower catches short replies, but also more noise." />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Shortest pause" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static ui:SpeakerSettingsViewModel.ShortestPauseChoices}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding ShortestPause}" MinWidth="110"
                                  ToolTip="A silence shorter than this doesn't end someone's turn. Lower catches quick back-and-forth." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <!-- Tabs above the transcript -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="16" Padding="{TemplateBinding Padding}" BorderThickness="1" Background="Transparent"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One paragraph of the transcript: the one playing is tinted, search hits are marked -->
        <Style x:Key="FlatLine" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,7" Margin="0,1" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40F5B400" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A paragraph of the transcript as read: click to jump there, the pencil (on hover) to edit it -->
        <!-- Small round icon buttons -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Fill="{DynamicResource SubtleFillColorSecondaryBrush}"
                                     Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="LineView" DataType="{x:Type ui:TranscriptLineViewModel}">
            <Grid x:Name="Root" Background="Transparent">
                <Button Style="{StaticResource FlatLine}" HorizontalContentAlignment="Stretch"
                        Command="{Binding DataContext.SeekLine, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Visibility="{Binding HasSpeaker, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0"
                                       Visibility="{Binding HasSpeaker, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding Stamp}" Style="{StaticResource Caption}" FontSize="10" FontFamily="Consolas" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Margin="0,2,28,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="Pencil" Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Padding="7,5"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Opacity="0"
                        Command="{Binding DataContext.EditLine, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" ToolTip="Edit this paragraph" AutomationProperties.Name="Edit this paragraph" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pencil" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- The same paragraph being edited: its speaker, its text, and what else can be done with it -->
        <DataTemplate x:Key="LineEdit" DataType="{x:Type ui:TranscriptLineViewModel}">
            <Border Margin="0,2" Padding="12,10" CornerRadius="10" BorderThickness="1"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox IsEditable="True" Width="200" HorizontalAlignment="Left"
                                  ItemsSource="{Binding DataContext.SpeakerNames, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Text="{Binding EditSpeaker, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Who says this: pick a speaker, or type a new name" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Starts at" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding EditTime, UpdateSourceTrigger=PropertyChanged}" Width="120" MinHeight="36" FontSize="15" FontFamily="Consolas"
                                     HorizontalContentAlignment="Center" PreviewKeyDown="EditBox_KeyDown"
                                     ToolTip="When this paragraph starts, like 1:05. It stays between the paragraph before and the one after." />
                            <Button Content="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,5" Margin="4,0,0,0"
                                    Command="{Binding DataContext.UseCurrentTime, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" ToolTip="Use the time of the player" AutomationProperties.Name="Use the time of the player" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="EditBox" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" FontSize="12"
                             MinHeight="64" Loaded="EditBox_Loaded" PreviewKeyDown="EditBox_KeyDown" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Save" Style="{DynamicResource AccentButtonStyle}" Padding="14,5" Margin="0,0,6,6"
                                Command="{Binding DataContext.SaveEdit, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Cancel" Padding="12,5" Margin="0,0,6,6"
                                Command="{Binding DataContext.CancelEdit, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Split at cursor" Padding="12,5" Margin="0,0,6,6" Click="SplitAtCursor_Click"
                                Tag="{Binding ElementName=EditBox}"
                                ToolTip="Cuts the text where the cursor is. The second part opens next, so you can give it to someone else." />
                        <Button Content="Merge up" Padding="12,5" Margin="0,0,6,6" IsEnabled="{Binding CanMergeUp}"
                                Command="{Binding DataContext.MergeUp, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" ToolTip="Join this paragraph to the one before it" />
                        <Button Content="Merge down" Padding="12,5" Margin="0,0,6,6" IsEnabled="{Binding CanMergeDown}"
                                Command="{Binding DataContext.MergeDown, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" ToolTip="Join this paragraph to the one after it" />
                        <Button Content="Delete" Padding="12,5" Margin="0,0,0,6"
                                Command="{Binding DataContext.DeleteLine, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" ToolTip="Remove this paragraph from the transcript" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Enter saves, Esc cancels." />
                    <TextBlock Text="{Binding EditError}" Foreground="#E5484D" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="LoadedRow" DataType="{x:Type ui:LoadedModelRow}">
            <Grid Margin="0,4" Opacity="{Binding Dim}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Error}" Foreground="#E5484D" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="8,2"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Where}" FontSize="12" />
                </Border>
                <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding Action}"
                        IsEnabled="{Binding CanAct}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Sidebar navigation: each tab is an icon and a label; the selected one gets a soft fill. -->
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="ui:Nav.Title" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,10" Margin="0,1" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="17" Width="22" VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Header" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextElement.FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The tab control becomes the whole window: sidebar on the left, the page in a large rounded panel. -->
        <Style x:Key="SidebarTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Margin="16,0,16,16">
                                <!-- Logo and wordmark: a bold "Zeppie", a lighter "Says" in the logo's purple. -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,48,0,24">
                                    <Image Source="Assets/zeppie.png" Width="40" Height="40" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock FontSize="26" Margin="12,0,0,3" VerticalAlignment="Center"
                                               FontFamily="Segoe UI Variable Display, Segoe UI">
                                        <Run Text="Zeppie" FontWeight="Bold" />
                                        <Run Text="Says" FontWeight="Normal" Foreground="{StaticResource WordmarkAccent}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- Room for the profile picker, which the window puts here: inside this template it would be hidden from screen readers -->
                                <Border DockPanel.Dock="Top" Height="52" Margin="0,0,0,20" />
                                <DockPanel IsItemsHost="True" LastChildFill="False" />
                            </DockPanel>

                            <Border Grid.Column="1" Margin="0,44,12,12" CornerRadius="16"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid Margin="56,40,52,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,16">
                                        <TextBlock Text="{Binding SelectedItem.(ui:Nav.Title), RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="30" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                                    </Grid>
                                    <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stats on the Dictation and Insights pages -->
        <Style x:Key="StatNumber" TargetType="Run">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        </Style>
        <Style x:Key="StatUnit" TargetType="Run">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="InsightCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="26,22" />
        </Style>
        <Style x:Key="InsightNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        </Style>
        <Style x:Key="InsightHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        </Style>
        <Style x:Key="InsightLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="InsightRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,18,0,18" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One dictation key: the key itself, its model, the language spoken and the language typed. -->
        <DataTemplate DataType="{x:Type ui:BindingViewModel}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,4"
                                Background="Transparent" BorderThickness="0" ToolTip="Remove this key"
                                AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}"
                                Command="{Binding DataContext.RemoveKey, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding DataContext.CanRemoveKeys, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Key" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBlock Grid.Column="1" Text="Model" Style="{StaticResource Caption}" Margin="8,0,0,4" />
                        <TextBlock Grid.Column="2" Text="You speak" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBlock Grid.Column="4" Text="{Binding OutputCaption}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <Button Grid.Row="1" Content="{Binding KeyLabel}" Command="{Binding RecordKey}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Padding="11,5"
                                ToolTip="Click, then press the key or key combination you want (Esc to cancel)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0"
                                  ItemsSource="{Binding DataContext.InstalledModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ModelId}"
                                  ToolTip="Model" />
                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding DataContext.Languages, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}"
                                  IsEnabled="{Binding LanguageEnabled}"
                                  ToolTip="The language you speak. Parakeet recognises it itself." />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox Grid.Row="1" Grid.Column="4"
                                  ItemsSource="{Binding DataContext.OutputLanguages, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OutputLanguage}"
                                  ToolTip="Another language here translates what you say, using your default style model (Styles page). For a key that asks, the language of the answer." />
                    </Grid>
                    <!-- Type what was said, or take it as a question and answer it in a card above the pill -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="What it does" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBlock Grid.Column="1" Text="{Binding ModelCaption}" Style="{StaticResource Caption}" Margin="8,0,0,4"
                                   Visibility="{Binding UsesModel, Converter={StaticResource Visible}}" />
                        <ComboBox Grid.Row="1" ItemsSource="{x:Static ui:BindingViewModel.Actions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Action}" AutomationProperties.Name="What it does"
                                  ToolTip="Ask a question: what you say is answered in a card above the pill, using what's selected and on screen" />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Visibility="{Binding UsesModel, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{x:Static ui:BindingViewModel.AskProviders}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding AskProvider}" AutomationProperties.Name="Answered by" />
                            <ComboBox Grid.Column="2" IsEditable="True" ItemsSource="{Binding AskModelSuggestions}"
                                      Text="{Binding AskModel, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Answering model"
                                      Visibility="{Binding UsesOwnAskModel, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding AskNotice}" Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding UsesModel, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding KeyProblem}" Foreground="#E5484D" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KeyProblem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <TabControl x:Name="Tabs" Style="{StaticResource SidebarTabs}" ItemContainerStyle="{StaticResource NavItem}">
            <!-- Dictation: the home page, a greeting with the keys and the headline stats -->
            <TabItem Header="Dictation" Tag="&#xE720;" x:Name="HomeTab" ui:Nav.Title="{Binding Insights.Greeting}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,18,16">
                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Hero: how to dictate, on the logo's purple -->
                        <Border CornerRadius="16" MinHeight="230" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7A48E0" Offset="0" />
                                    <GradientStop Color="#4A28B0" Offset="0.55" />
                                    <GradientStop Color="#24146A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="36,32,12,30" VerticalAlignment="Center">
                                    <TextBlock Text="Talk anywhere you write" Foreground="White" FontSize="30" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Display, Segoe UI" TextWrapping="Wrap" />
                                    <TextBlock Foreground="White" Opacity="0.82" FontSize="15" Margin="0,8,0,20" TextWrapping="Wrap"
                                               Text="Hold a key and talk, or tap it to keep listening. Your words land wherever your cursor is, and everything runs on this PC." />
                                    <ItemsControl ItemsSource="{Binding Keys}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ui:BindingViewModel}">
                                                <Border Background="#33FFFFFF" CornerRadius="10" Padding="14,8" Margin="0,0,10,8">
                                                    <TextBlock Foreground="White" FontSize="14" TextWrapping="Wrap">
                                                        <Run Text="{Binding KeyLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="  " /><Run Text="{Binding ModelName, Mode=OneWay}" />
                                                        <Run Text="{Binding OutputLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- The logo's sound bars, as decoration -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,36,0"
                                            Opacity="0.9">
                                    <StackPanel.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="14" />
                                            <Setter Property="CornerRadius" Value="7" />
                                            <Setter Property="Margin" Value="5,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                        <GradientStop Color="#D9E4DCFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Border Height="22" Opacity="0.5" />
                                    <Border Height="52" Opacity="0.7" />
                                    <Border Height="84" />
                                    <Border Height="124" />
                                    <Border Height="84" />
                                    <Border Height="52" Opacity="0.7" />
                                    <Border Height="22" Opacity="0.5" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Headline stats -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0" Padding="28,22" VerticalAlignment="Stretch"
                                DataContext="{Binding Insights}">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,6" />
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock>
                                    <Run Text="{Binding TotalWords, Mode=OneWay, StringFormat=N0}" Style="{StaticResource StatNumber}" />
                                    <Run Text="  total words" Style="{StaticResource StatUnit}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="{Binding Wpm, Mode=OneWay}" Style="{StaticResource StatNumber}" />
                                    <Run Text="  wpm" Style="{StaticResource StatUnit}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="{Binding Streak, Mode=OneWay}" Style="{StaticResource StatNumber}" />
                                    <Run Text="{Binding StreakUnit, Mode=OneWay, StringFormat='  {0}'}" Style="{StaticResource StatUnit}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- The latest dictations, newest first; only while the history is on in Settings -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,28,0,0">
                            <Grid Margin="2,0,0,10" Visibility="{Binding KeepHistory, Converter={StaticResource Visible}}">
                                <TextBlock Text="Recent dictations" Style="{StaticResource SectionTitle}" Margin="0" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,0"
                                       Text="Nothing yet. What you dictate shows up here, newest on top."
                                       Visibility="{Binding ShowHistoryEmpty, Converter={StaticResource Visible}}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,0"
                                       Visibility="{Binding HistoryOff, Converter={StaticResource Visible}}">
                                <Run Text="The dictation history is off. " /><Hyperlink Click="OpenSettings_Click">Turn it on in Settings</Hyperlink>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding History.Entries}" Visibility="{Binding KeepHistory, Converter={StaticResource Visible}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:DictationEntry}">
                                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Margin="0,6,0,0" FontSize="12"
                                                               Visibility="{Binding HasOriginal, Converter={StaticResource Visible}}">
                                                        <Hyperlink Command="{Binding ToggleOriginal}"><Run Text="{Binding OriginalToggleLabel, Mode=OneWay}" /></Hyperlink>
                                                    </TextBlock>
                                                    <!-- What you said, before the style rewrote it -->
                                                    <Border Margin="0,6,0,0" Padding="12,8" CornerRadius="8"
                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                            Visibility="{Binding ShowOriginal, Converter={StaticResource Visible}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="As transcribed" Style="{StaticResource Caption}" />
                                                                <TextBlock Text="{Binding Original}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,5"
                                                                    VerticalAlignment="Top" Margin="12,0,0,0" ToolTip="Copy the original"
                                                                    AutomationProperties.Name="Copy the original"
                                                                    Command="{Binding DataContext.CopyText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Original}" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                    <Button Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,5"
                                                            ToolTip="Copy" AutomationProperties.Name="Copy this dictation"
                                                            Command="{Binding DataContext.CopyText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Text}" />
                                                    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,5" Margin="4,0,0,0"
                                                            ToolTip="Remove from the history" AutomationProperties.Name="Remove from the history"
                                                            Command="{Binding DataContext.RemoveHistoryEntry, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Notetaker: the recordings in a list on the left; beside it, the selected one with its player, speakers and transcript -->
            <TabItem Header="Notetaker" Tag="&#xE7C8;" x:Name="NotetakerTab">
                <Grid DataContext="{Binding Notetaker}" AllowDrop="True" Drop="Notetaker_Drop" DragOver="Notetaker_DragOver"
                      Background="Transparent" Margin="0,4,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NoteListColumn" Width="165" MinWidth="120" MaxWidth="420" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="400" />
                    </Grid.ColumnDefinitions>

                    <!-- The recordings from top to bottom under a heading per day, newest first, with Record and Add files above
                         them: they make the recordings, so they sit where the recordings are. The splitter makes the list wider or
                         narrower; collapsed it is a rail with just the buttons. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,2,0,6">
                            <TextBlock Text="Conversations" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Visibility="{Binding ListExpanded, Converter={StaticResource Visible}}" />
                            <Button Command="{Binding ToggleList}" HorizontalAlignment="Right" Padding="8,5"
                                    Background="Transparent" BorderThickness="0"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                    AutomationProperties.Name="Collapse or expand the list of conversations">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="&#xE76B;" />
                                        <Setter Property="ToolTip" Value="Collapse the list" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ListCollapsed}" Value="True">
                                                <Setter Property="Content" Value="&#xE76C;" />
                                                <Setter Property="ToolTip" Value="Show the list of conversations" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,0,10,10">
                            <Button Command="{Binding ToggleRecording}" ToolTip="{Binding RecordLabel}" Height="28"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,0"
                                    AutomationProperties.Name="{Binding RecordLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                                        <Ellipse Width="13" Height="13" Fill="#E5484D">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Meetings.IsRecording}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="#E5484D">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Meetings.IsRecording}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>
                                    <TextBlock Text="{Binding RecordLabel}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding ListExpanded, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BrowseFiles}" Height="26" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Padding="4,0"
                                    ToolTip="Add audio or video files (or drop them anywhere on this page)"
                                    AutomationProperties.Name="Add audio or video files">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Add files" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding ListExpanded, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Find a conversation: by its title, who was in it, or what was said -->
                        <Grid Grid.Row="2" Margin="0,0,10,8" Visibility="{Binding ListExpanded, Converter={StaticResource Visible}}">
                            <TextBox Text="{Binding JobSearch, UpdateSourceTrigger=PropertyChanged}" Padding="8,3,28,3" FontSize="11"
                                     ToolTip="Find a conversation by its name, the people in it, or what was said" />
                            <TextBlock Text="Search conversations" Style="{StaticResource Caption}" TextWrapping="NoWrap" Margin="10,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                       Visibility="{Binding JobSearch, Converter={StaticResource EmptyToVisible}}" />
                            <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Padding="6,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                    Background="Transparent" BorderThickness="0" Command="{Binding ClearJobSearch}"
                                    ToolTip="Clear the search" AutomationProperties.Name="Clear the search"
                                    Visibility="{Binding HasJobSearch, Converter={StaticResource Visible}}" />
                        </Grid>
                        <ListBox x:Name="JobStrip" Grid.Row="3" ItemsSource="{Binding JobsView}" SelectedItem="{Binding Selected}"
                                 BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding ListExpanded, Converter={StaticResource Visible}}"
                                 KeyDown="JobStrip_KeyDown">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="10"
                                                       Margin="6,8,0,3" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <!-- Quiet rows: a soft fill when selected, a hairline only on hover -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="8" Padding="8,5" Margin="0,0,10,1" BorderThickness="1"
                                                        Background="Transparent" BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type notes:NoteJob}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename" InputGestureText="F2" Click="RenameJob_Click"
                                                          IsEnabled="{Binding IsDone}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <!-- The name on up to two lines, then the time and how far -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="10.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       LineStackingStrategy="BlockLineHeight" LineHeight="14" MaxHeight="28" ToolTip="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                       TextWrapping="NoWrap" ToolTip="{Binding StatusText}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1}">
                                                        <Binding Path="Time" />
                                                        <Binding Path="StatusText" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,5,0,0"
                                                         Foreground="{StaticResource Accent}"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                         Visibility="{Binding IsWorking, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{Binding IsFailed, Converter={StaticResource Visible}}">
                                            <Button Content="Retry" Padding="8,2" FontSize="12"
                                                    Command="{Binding DataContext.Retry, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,3" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RecycleJob, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" ToolTip="Move to the Recycle Bin"
                                                    AutomationProperties.Name="Move to the Recycle Bin" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                  Visibility="{Binding ListExpanded, Converter={StaticResource Visible}}" />

                    <Grid Grid.Column="2">
                        <!-- Nothing picked yet, or still being transcribed -->
                        <Border Style="{StaticResource Card}" Margin="0" Visibility="{Binding ShowPlaceholder, Converter={StaticResource Visible}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="{Binding Placeholder}" Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center" />
                                <ProgressBar Value="{Binding Selected.Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,12,0,0"
                                             Foreground="{StaticResource Accent}"
                                             IsIndeterminate="{Binding Selected.IsIndeterminate, Mode=OneWay}"
                                             Visibility="{Binding Selected.IsWorking, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Border>

                        <!-- A dropped file waits here: its own settings, then Start -->
                        <Border Margin="0" Padding="0" HorizontalAlignment="Left" MaxWidth="680">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.IsReady}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="24,20,20,20">
                                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,0,0,16" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Text" Value="Settings for this file only. Your general Notetaker settings are on the Settings page and stay as they are." />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected.IsRedo}" Value="True">
                                                        <Setter Property="Text" Value="Finds the speakers anew with these settings. The current transcript, with your corrections, is kept in the Done\Previous folder." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Doing a finished transcript again: keep the words, or transcribe again -->
                                    <StackPanel Margin="0,0,0,16" Visibility="{Binding Selected.IsRedo, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
                                        <RadioButton GroupName="RedoKind" IsChecked="{Binding Selected.Options.KeepText}"
                                                     IsEnabled="{Binding Selected.Options.CanKeepText}"
                                                     Content="Only find the speakers again: keeps the text, takes seconds" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="28,0,0,6" TextWrapping="Wrap"
                                                   Visibility="{Binding Selected.Options.CanKeepText, Converter={StaticResource Visible}}"
                                                   Text="The words already heard are handed out to the speakers found now, word by word." />
                                        <TextBlock Margin="28,0,0,6" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="Text" Value="Not for this transcript: it was made before Zeppie Says kept when each word was said. Transcribe it again once, and from then on this works." />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selected.Options.CanKeepText}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <RadioButton GroupName="RedoKind" IsChecked="{Binding Selected.Options.TranscribeAgain}"
                                                     Content="Transcribe again: also with another speech model or language, takes minutes" />
                                    </StackPanel>

                                    <TextBlock Text="Title" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Selected.Options.Title, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,14"
                                               Text="The heading of the transcript. Leave empty to use the file name." />

                                    <!-- How it is transcribed; not used when only the speakers are found again -->
                                    <Grid IsEnabled="{Binding Selected.Options.TranscribeAgain}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Model" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding DataContext.InstalledModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Selected.Options.ModelId}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Language" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding DataContext.Languages, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Selected.Options.Language}"
                                                      ToolTip="Whisper only; Parakeet detects the language itself" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <CheckBox Content="Label speakers" IsChecked="{Binding Selected.Options.LabelSpeakers}"
                                                  VerticalAlignment="Center" Margin="0,0,16,0" IsEnabled="{Binding Selected.Options.TranscribeAgain}"
                                                  ToolTip="Speaker 1, Speaker 2 per paragraph. Downloads two small models (33 MB) the first time." />
                                        <ComboBox ItemsSource="{x:Static ui:NotetakerViewModel.SpeakerCounts}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding Selected.Options.SpeakersChoice}" MinWidth="104"
                                                  IsEnabled="{Binding Selected.Options.LabelSpeakers}" VerticalAlignment="Center"
                                                  ToolTip="If you know how many people speak, pick it: speaker labels get much more reliable" />
                                    </StackPanel>
                                    <Expander Header="Speaker detection (advanced)" Margin="0,10,0,0" IsEnabled="{Binding Selected.Options.LabelSpeakers}"
                                              IsExpanded="{Binding Selected.IsRedo, Mode=OneWay}">
                                        <StackPanel Margin="0,10,0,4">
                                            <TextBlock Text="Voice model" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{x:Static ui:NotetakerViewModel.VoiceModels}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Selected.Options.VoiceModel}"
                                                      HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,14"
                                                      ToolTip="Tells the voices in this file apart. People you named are learned for this model first, from earlier recordings, when it doesn't know them yet." />
                                            <ContentControl Content="{Binding SelectedSpeakerDetection}" ContentTemplate="{StaticResource SpeakerDetectionPanel}"
                                                            Focusable="False" IsEnabled="{Binding Selected.Options.UsesLocalVoiceModel}" />
                                        </StackPanel>
                                    </Expander>
                                    <CheckBox Content="Summary and action items" IsChecked="{Binding Selected.Options.Summarize}" Margin="0,10,0,0"
                                              ToolTip="Written by your default style model (Styles page)" />
                                    <CheckBox Content="Dictionary hints" IsChecked="{Binding Selected.Options.UseDictionary}" Margin="0,10,0,0"
                                              IsEnabled="{Binding Selected.Options.TranscribeAgain}"
                                              ToolTip="Gives your dictionary words to Whisper so names are spelled right" />

                                    <TextBlock Text="About this recording" Style="{StaticResource Caption}" Margin="0,18,0,4" />
                                    <TextBox Text="{Binding Selected.Options.Context, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0"
                                               Text="Optional. For example: Planning meeting with Jan de Vries and Sara about Project Aurora. Names help the spelling and the summary." />

                                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                        <Button Content="Start" Command="{Binding StartJob}" CommandParameter="{Binding Selected}"
                                                Style="{DynamicResource AccentButtonStyle}" MinWidth="96" />
                                        <Button Command="{Binding DiscardJob}" CommandParameter="{Binding Selected}" Margin="8,0,0,0" MinWidth="84">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Remove" />
                                                    <Setter Property="ToolTip" Value="Takes the file off the list. A copy made in the Notetaker folder is deleted; your original stays." />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selected.IsRedo}" Value="True">
                                                            <Setter Property="Content" Value="Cancel" />
                                                            <Setter Property="ToolTip" Value="Keeps the transcript as it is" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Start all" Command="{Binding StartAll}" Margin="8,0,0,0"
                                                Visibility="{Binding HasSeveralReady, Converter={StaticResource Visible}}"
                                                ToolTip="Starts every waiting file, each with its own settings" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- A finished recording: player and speakers on the left, transcript and summary on the right -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.IsDone}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.5*" MinWidth="300" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- The picture for a video, a waveform for audio -->
                                <Border CornerRadius="12" Background="#14161B" ClipToBounds="True" MinHeight="140">
                                    <Grid>
                                        <Border Background="{Binding Playback.VideoBrush}"
                                                Visibility="{Binding Playback.ShowVideo, Converter={StaticResource Visible}}" />
                                        <Grid Margin="20,16" Visibility="{Binding Playback.ShowWaveform, Converter={StaticResource Visible}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <!-- The recording's name: click it to rename the recording and its transcript -->
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.Date}" Foreground="#9AA0AA" FontSize="12"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                <TextBox x:Name="RecordingTitle" Text="{Binding SelectedTitle, UpdateSourceTrigger=LostFocus}"
                                                         Foreground="#E6E8EC" CaretBrush="#E6E8EC" FontSize="14" FontWeight="SemiBold"
                                                         Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Transparent" Padding="0,2"
                                                         MinWidth="0" HorizontalAlignment="Left" KeyDown="RecordingTitle_KeyDown"
                                                         ToolTip="Click to rename (F2). Renames the recording, its transcript and the files with them."
                                                         AutomationProperties.Name="Recording name">
                                                    <TextBox.Template>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Border x:Name="Line" BorderThickness="0,0,0,1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                                                <ScrollViewer x:Name="PART_ContentHost" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Line" Property="BorderBrush" Value="#5A606B" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </TextBox.Template>
                                                </TextBox>
                                            </DockPanel>
                                            <ui:WaveformView Grid.Row="1" Margin="0,10,0,0" Peaks="{Binding Peaks}" Duration="{Binding Duration}"
                                                             Segments="{Binding WaveSegments}"
                                                             Position="{Binding Playback.Position}" SeekCommand="{Binding SeekCommand}" />
                                        </Grid>
                                        <TextBlock Text="The audio or video file is no longer next to its transcript, so it can't be played."
                                                   Foreground="#A8ADB8" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Playback.IsMissing, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </Border>

                                <!-- Play, the time, and for a video a strip to jump around in -->
                                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0"
                                        Visibility="{Binding Playback.IsOpen, Converter={StaticResource Visible}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding Playback.PlayPauseCommand}" Width="40" Height="40" Padding="0"
                                                    Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Play or pause">
                                                <TextBlock Text="{Binding Playback.PlayGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
                                            </Button>
                                            <TextBlock Text="{Binding Playback.TimeText}" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" />
                                        </StackPanel>
                                        <!-- 7 px + the card's 12 px + 1 px border = the 20 px the speaker bars and the audio waveform are inset by -->
                                        <ui:WaveformView Height="40" Margin="7,10,7,0" Peaks="{Binding Peaks}" Duration="{Binding Duration}"
                                                         Segments="{Binding WaveSegments}"
                                                         Position="{Binding Playback.Position}" SeekCommand="{Binding SeekCommand}"
                                                         Visibility="{Binding Playback.ShowVideo, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Who spoke when; click a bar to jump there, click a name to change it -->
                                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="19,10" Margin="0,10,0,0"
                                        Visibility="{Binding HasSpeakers, Converter={StaticResource Visible}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4"
                                                   Text="The timeline is available for files transcribed from now on. Names can still be changed."
                                                   Visibility="{Binding ShowTimelineHint, Converter={StaticResource Visible}}" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                            <ItemsControl ItemsSource="{Binding SpeakerRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type ui:SpeakerRowViewModel}">
                                                        <StackPanel Margin="0,0,0,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,5" />
                                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                                                         MinWidth="140" BorderThickness="0" Background="Transparent" Padding="2,2" FontSize="13"
                                                                         VerticalAlignment="Center" KeyDown="SpeakerName_KeyDown"
                                                                         ToolTip="{Binding Label}" />
                                                            </StackPanel>
                                                            <ui:SegmentTrack Height="22" Segments="{Binding Segments}" Brush="{Binding Brush}"
                                                                             Duration="{Binding DataContext.Duration, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             Position="{Binding DataContext.Playback.Position, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             SeekCommand="{Binding DataContext.SeekCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Transcript and summary -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="16,14,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="&#xE8F2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="11,6"
                                                         GroupName="NoteTab" IsChecked="{Binding ShowTranscript}" Style="{StaticResource Chip}"
                                                         ToolTip="Transcript" AutomationProperties.Name="Transcript" />
                                            <RadioButton Content="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="11,6"
                                                         GroupName="NoteTab" IsChecked="{Binding ShowSummary}" IsEnabled="{Binding CanOpenSummary}"
                                                         Style="{StaticResource Chip}"
                                                         ToolTip="Samenvatting, besluiten en actiepunten" AutomationProperties.Name="Samenvatting" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="9,6" Margin="8,0,0,0"
                                                    Command="{Binding OpenTranscript}" CommandParameter="{Binding Selected}"
                                                    ToolTip="Open the transcript file" AutomationProperties.Name="Open the transcript file" />
                                            <Button Content="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="9,6" Margin="4,0,0,0"
                                                    Command="{Binding ShowInFolder}" CommandParameter="{Binding Selected}"
                                                    ToolTip="Show in folder" AutomationProperties.Name="Show in folder" />
                                            <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="9,6" Margin="4,0,0,0"
                                                    Command="{Binding RedoJob}" CommandParameter="{Binding Selected}"
                                                    ToolTip="Find the speakers again, with other settings: keeps the text when it can, or transcribes again. The current transcript is kept."
                                                    AutomationProperties.Name="Find the speakers again" />
                                            <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="9,6" Margin="4,0,0,0"
                                                    Command="{Binding RecycleJob}" CommandParameter="{Binding Selected}"
                                                    ToolTip="Move the recording, the transcript and everything with it to the Recycle Bin"
                                                    AutomationProperties.Name="Move to the Recycle Bin" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="16,0,12,8" Visibility="{Binding ShowTranscript, Converter={StaticResource Visible}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search the transcript; Enter jumps to the next hit">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding NextMatch}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Text="Search the transcript" Style="{StaticResource Caption}" TextWrapping="NoWrap" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding MatchText}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                                       VerticalAlignment="Center" Margin="10,0,6,0" />
                                            <Button Grid.Column="2" Content="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="9,6"
                                                    Command="{Binding PreviousMatch}" ToolTip="Previous hit" />
                                            <Button Grid.Column="3" Content="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="9,6"
                                                    Command="{Binding NextMatch}" Margin="4,0,0,0" ToolTip="Next hit" />
                                            <Button Grid.Column="4" Content="Replace" Padding="10,6" Margin="8,0,0,0" Command="{Binding ToggleReplace}"
                                                    ToolTip="Replace the searched word everywhere in this transcript" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0" Visibility="{Binding ShowReplace, Converter={StaticResource Visible}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" ToolTip="What to put in place of the searched text" />
                                            <TextBlock Text="Replace with" Style="{StaticResource Caption}" TextWrapping="NoWrap" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                                       Visibility="{Binding ReplaceText, Converter={StaticResource EmptyToVisible}}" />
                                            <Button Grid.Column="1" Content="Replace all" Command="{Binding ReplaceAll}" Margin="8,0,0,0" Padding="12,6" />
                                        </Grid>
                                        <TextBlock Text="{Binding ReplaceMessage}" Style="{StaticResource Caption}" Margin="2,4,0,0"
                                                   Visibility="{Binding ShowReplace, Converter={StaticResource Visible}}" />
                                        <!-- Words that were corrected, for the dictionary -->
                                        <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="10" Background="{StaticResource AccentSoft}"
                                                Visibility="{Binding HasSuggestions, Converter={StaticResource Visible}}">
                                            <StackPanel>
                                                <TextBlock Text="Add these to your dictionary, so they come out right next time?" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type ui:DictionarySuggestion}">
                                                            <Button Content="{Binding Label}" Padding="10,4" Margin="0,0,6,6" FontSize="12"
                                                                    Command="{Binding DataContext.AddSuggestion, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="Add to the dictionary" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="Dismiss" Command="{Binding DismissSuggestions}" HorizontalAlignment="Left"
                                                        Padding="10,3" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <ListBox x:Name="TranscriptList" ItemsSource="{Binding Lines}" BorderThickness="0" Background="Transparent"
                                                 Margin="6,0,6,6" HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 PreviewMouseWheel="Transcript_PreviewMouseWheel" PreviewMouseLeftButtonDown="Transcript_PreviewMouseDown"
                                                 Visibility="{Binding ShowTranscript, Converter={StaticResource Visible}}">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:TranscriptLineViewModel}">
                                                    <ContentControl Content="{Binding}">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="ContentTemplate" Value="{StaticResource LineView}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource LineEdit}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="Sync with playback" Command="{Binding SyncNow}" Style="{DynamicResource AccentButtonStyle}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,14" Padding="14,6"
                                                Visibility="{Binding ShowSync, Converter={StaticResource Visible}}" />

                                        <Grid Visibility="{Binding ShowSummary, Converter={StaticResource Visible}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <FlowDocumentScrollViewer ui:Markdown.Text="{Binding Summary}" Padding="20,0,14,14"
                                                                      VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
                                            <TextBlock Text="No summary yet." Style="{StaticResource Caption}" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding Summary, Converter={StaticResource EmptyToVisible}}" />
                                            <StackPanel Grid.Row="1" Margin="20,0,14,16">
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                                           Text="The transcript was edited after this summary was written."
                                                           Visibility="{Binding SummaryOutdated, Converter={StaticResource Visible}}" />
                                                <TextBlock Text="{Binding SummaryError}" Foreground="#E5484D" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SummaryError}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="{Binding RegenerateLabel}" Command="{Binding RegenerateSummary}" HorizontalAlignment="Left"
                                                        Padding="14,6" IsEnabled="{Binding SummaryAvailable}"
                                                        ToolTip="Writes the summary, decisions and action items again from the transcript as it is now" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Keys -->
            <TabItem Header="Keys" Tag="&#xE765;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,18,16">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasNoModels, Converter={StaticResource Visible}}"
                                Background="{StaticResource AccentSoft}">
                            <StackPanel>
                                <TextBlock Text="Install a model to get started" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Open the Local models tab. For Dutch, Whisper large-v3 turbo is a good start; for English, Parakeet v2." />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Margin="4,0,4,12" TextWrapping="Wrap">
                            <Run Text="The model and language of each key belong to the profile" />
                            <Run Text="{Binding ActiveProfile.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="; switch it at the top left or from the tray. The keys themselves and the language they type in are the same in every profile." />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Keys}" />
                        <Button Command="{Binding AddKey}" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="12,6"
                                AutomationProperties.Name="Add a key">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                                <TextBlock Text="Add a key" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource Caption}" Margin="4,4,4,0"
                                   Text="Click a key field and press the key or combination you want, like F8 or Ctrl + Win. Hold it while you talk, or tap it once to keep listening and tap again to finish. Esc cancels. The text goes wherever your cursor is." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Models -->
            <TabItem Header="Local models" Tag="&#xE8F1;" x:Name="ModelsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,18,16">
                    <StackPanel>
                        <!-- What is in memory right now, and where it runs. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="In memory now" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="A loaded model answers at once. An unloaded one is read from disk first, which takes seconds. Unloading frees graphics memory for games or video calls." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Unload all" Command="{Binding Loaded.UnloadAll}"
                                            IsEnabled="{Binding Loaded.HasLoaded}" VerticalAlignment="Top" Margin="12,0,0,0" />
                                </Grid>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding Loaded.HasGpuInfo, Converter={StaticResource Visible}}">
                                    <ProgressBar Value="{Binding Loaded.GpuFraction, Mode=OneWay}" Maximum="1" Height="6" />
                                    <TextBlock Text="{Binding Loaded.GpuText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>

                                <TextBlock Text="Speech models" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <ItemsControl ItemsSource="{Binding Loaded.SpeechRows}" ItemTemplate="{StaticResource LoadedRow}" />
                                <TextBlock Text="Install a speech model below to see it here.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Loaded.SpeechRows.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Text models (Ollama)" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <TextBlock Text="Ollama isn't running, so nothing can be shown or loaded here." Style="{StaticResource Caption}"
                                           Foreground="#E5484D" Visibility="{Binding Loaded.OllamaDown, Converter={StaticResource Visible}}" />
                                <ItemsControl ItemsSource="{Binding Loaded.TextRows}" ItemTemplate="{StaticResource LoadedRow}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Catalog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:ModelRowViewModel}">
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" />
                                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="6,0" Margin="8,0,0,0"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="Installed" FontSize="11" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Info.Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Opacity="0.8" Margin="0,2,0,0" />
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,8,0,0"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                                <TextBlock Text="{Binding Error}" Foreground="#E5484D" FontSize="12" Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding Action}"
                                                    MinWidth="84" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="4,2,4,12" Style="{StaticResource Caption}">
                            <Hyperlink Command="{Binding AddCustomModel}">Add your own Whisper model file…</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Dictionary -->
            <TabItem Header="Dictionary" Tag="&#xE82D;">
                <Grid Margin="0,12,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Dictionary files: click one to edit its words on the left -->
                    <Border Grid.Column="2" Grid.RowSpan="4" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Dictionary files" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                       Text="Click a file to edit its words. They're plain text files, so you can also share one, for example a team list in a shared folder. Changes are picked up as soon as a file is saved." />
                            <ListBox ItemsSource="{Binding DictionaryFileList}" SelectedItem="{Binding SelectedDictionaryFile}"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="8,6" Margin="0,1" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type services:DictionaryFile}">
                                        <Grid ToolTip="{Binding FullPath}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} words{1}">
                                                            <Binding Path="Words" />
                                                            <Binding Path="Problem" StringFormat=" · {0}" TargetNullValue="" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    Padding="8,4" Background="Transparent" BorderThickness="0" ToolTip="Open in your text editor"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Open {0} in a text editor'}"
                                                    Command="{Binding DataContext.OpenDictionaryFile, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    Padding="8,4" BorderThickness="0"
                                                    ToolTip="Stop using this file (the file itself stays)"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"
                                                    Command="{Binding DataContext.RemoveDictionaryFile, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <!-- The default file is always there: one place your words can go -->
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Add file…" Command="{Binding AddDictionaryFile}" Margin="0,0,8,8" />
                                <Button Content="New file…" Command="{Binding NewDictionaryFile}" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- The words of the selected file -->
                    <TextBlock Text="{Binding SelectedDictionaryFile.Name, FallbackValue='Dictionary'}" Style="{StaticResource SectionTitle}"
                               Margin="2,0,0,10" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedDictionaryFile.FullPath}" />
                    <TextBox Grid.Row="1" x:Name="WordBox" Text="{Binding NewWord, UpdateSourceTrigger=PropertyChanged}" KeyDown="WordBox_KeyDown"
                             AutomationProperties.Name="New word" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="4,6,4,10"
                               Text="Type a word and press Enter. To fix a word that keeps coming out wrong, write it as  Lumora = lu mora, loo mora" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding Dictionary}" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:DictionaryEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Term}" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding SoundsLike}" Margin="10,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Padding="8,2" Background="Transparent" BorderThickness="0"
                                            ToolTip="Remove" AutomationProperties.Name="{Binding Term, StringFormat='Remove {0}'}"
                                            Command="{Binding DataContext.RemoveWord, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Styles -->
            <TabItem Header="Styles" Tag="&#xE8D2;" x:Name="StylesTab">
                <!-- Every style in a list; the selected one in the editor beside it; the default model above. Ollama and the keys are on the Settings page. -->
                <Grid DataContext="{Binding Styles}" Margin="0,4,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Top bar: the profile, and the default model it holds -->
                    <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap">
                                <Run Text="A style decides how your dictation is tidied up: by rules only, or rewritten by an AI. Each app or website can have its own. The default model and the model of each style belong to the profile" />
                                <Run Text="{Binding DataContext.ActiveProfile.Name, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" /><Run Text="; switch it at the top left. The Ollama address and API keys are under" />
                                <Hyperlink Click="OpenAiProviders_Click">Settings, AI providers</Hyperlink><Run Text="." />
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Default model, used by every style unless it picks another" Style="{StaticResource Caption}"
                                               Margin="0,0,0,4" TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{x:Static ui:StylesViewModel.DefaultProviders}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding DefaultProvider}" />
                                        <ComboBox Grid.Column="2" IsEditable="True" ItemsSource="{Binding DefaultModelSuggestions}"
                                                  Text="{Binding DefaultModel, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding DefaultIsLocal, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Keep the model loaded" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{x:Static ui:StylesViewModel.KeepLoadedChoices}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding KeepLoaded}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                                               Text="Longer means no loading pause after a break, but the model keeps using graphics memory (about 5 GB for qwen3:8b)." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- The styles -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="10">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Command="{Binding AddStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="10,8" Margin="0,0,0,8" Style="{DynamicResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="New style" />
                                </StackPanel>
                            </Button>
                            <ListBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Selected}"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Margin="0,1" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:StyleViewModel}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0" Background="{StaticResource AccentSoft}"
                                                        VerticalAlignment="Center" Visibility="{Binding IsDefault, Converter={StaticResource Visible}}"
                                                        ToolTip="Used for every app and website without a style of its own">
                                                    <TextBlock Text="Default" FontSize="11" Foreground="{StaticResource Accent}" />
                                                </Border>
                                                <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" Foreground="#C77700" ToolTip="Sends your text to a cloud AI"
                                                           Visibility="{Binding IsCloud, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding UsedIn}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Visibility="{Binding HasUsedIn, Converter={StaticResource Visible}}" ToolTip="{Binding UsedIn}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- The selected style -->
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
                            <StackPanel>
                                <StackPanel DataContext="{Binding Selected}">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="20" FontWeight="SemiBold"
                                             BorderThickness="0,0,0,1" Background="Transparent" Padding="0,2" Margin="0,0,0,4"
                                             AutomationProperties.Name="Style name" ToolTip="Click to rename" />
                                    <CheckBox Content="Use for everything else" IsChecked="{Binding IsDefault}" IsEnabled="{Binding CanMakeDefault}"
                                              Margin="0,6,0,0"
                                              ToolTip="The style for every app and website without one of its own. Pick another style to move it." />

                                    <!-- How it rewrites -->
                                    <TextBlock Text="How it rewrites" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="AI" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{x:Static ui:StylesViewModel.Providers}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Provider}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding UsesOwnModel, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Model" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                            <ComboBox IsEditable="True" ItemsSource="{Binding ModelSuggestions}"
                                                      Text="{Binding ModelName, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding UsesDefault, Converter={StaticResource Visible}}">
                                            <TextBlock Text="How much may it change?" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{x:Static ui:StylesViewModel.Strengths}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Strength}" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- With its own model, the strength gets a row of its own -->
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding UsesOwnModel, Converter={StaticResource Visible}}">
                                        <TextBlock Text="How much may it change?" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{x:Static ui:StylesViewModel.Strengths}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding Strength}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DefaultNotice}" Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding UsesDefault, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding CloudNotice}" Foreground="#C77700" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding IsCloud, Converter={StaticResource Visible}}" />

                                    <StackPanel Visibility="{Binding UsesAi, Converter={StaticResource Visible}}">
                                        <TextBlock Text="Your rules, in plain words" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                                        <TextBox Text="{Binding Instructions, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                                                 TextWrapping="Wrap" MinHeight="84" VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Where it is used -->
                                <TextBlock Text="Used in" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
                                <ItemsControl ItemsSource="{Binding SelectedRules}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:RuleViewModel}">
                                            <!-- Apps in the accent color with an app icon; websites in teal with a globe -->
                                            <Border CornerRadius="14" Padding="10,4,4,4" Margin="0,0,6,6" ToolTip="{Binding ChipTip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWebsite}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource WebsiteSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                                                               Margin="0,0,7,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE7F4;" />
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWebsite}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE774;" />
                                                                        <Setter Property="Foreground" Value="{StaticResource Website}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ChipText}" VerticalAlignment="Center" />
                                                    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                            Padding="6,4" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                                                            ToolTip="Remove" AutomationProperties.Name="{Binding ChipText, StringFormat='Remove {0}'}"
                                                            Command="{Binding DataContext.RemoveRule, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,8"
                                           Visibility="{Binding NoSelectedRules, Converter={StaticResource Visible}}"
                                           Text="No apps or websites yet." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{x:Static ui:StylesViewModel.RuleKinds}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding NewRuleKind}" MinWidth="110" />
                                    <ComboBox Grid.Column="1" Margin="6,0" IsEditable="True" ItemsSource="{Binding MatchSuggestions}"
                                              Text="{Binding NewRuleMatch, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Pick an app you dictated into recently, or type a program name or words from a website's title" />
                                    <Button Grid.Column="2" Content="Add" Command="{Binding AddRule}" MinWidth="64" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap"
                                           Text="Apps you dictate into show up in the list. A website matches words in the window title (such as Gmail) and wins over an app." />
                                <!-- What the two colors mean -->
                                <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="App" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Website}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Website or window title" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Try it -->
                                <TextBlock Text="Try it" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TryText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static ui:StylesViewModel.OutputLanguages}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding TryOutputLanguage}" Margin="8,0,0,0"
                                              MinWidth="120" VerticalAlignment="Top"
                                              ToolTip="Type in: try a translation, as a key with this output language would (Keys page)" />
                                    <Button Grid.Column="2" Content="Try" Command="{Binding TryStyle}" Margin="8,0,0,0" MinWidth="64"
                                            VerticalAlignment="Top" Style="{DynamicResource AccentButtonStyle}" />
                                </Grid>
                                <Border CornerRadius="8" Padding="12,10" Margin="0,8,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{Binding TryResult, Converter={StaticResource EmptyToVisible}, ConverterParameter=Not}">
                                    <TextBlock Text="{Binding TryResult}" TextWrapping="Wrap" />
                                </Border>

                                <Button Content="Delete style" Command="{Binding DeleteStyle}" IsEnabled="{Binding CanDeleteSelected}"
                                        HorizontalAlignment="Right" Margin="0,28,0,0" MinWidth="100"
                                        ToolTip="Apps and websites that used it go back to the default style" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </Grid>
            </TabItem>

            <!-- Settings -->
            <!-- Settings sits at the bottom of the sidebar. -->
            <TabItem Header="Settings" Tag="&#xE713;" DockPanel.Dock="Bottom" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,18,16">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding UseScreenContext}" Content="Use what's on screen" />
                                <TextBlock Style="{StaticResource Caption}" Margin="28,0,0,12"
                                           Text="Reads the app you're in (text near the cursor, names like variables in VS Code) to spell things right. Done on this PC with Windows OCR; nothing leaves your machine." />
                                <CheckBox IsChecked="{Binding RemoveFillerWords}" Content="Remove filler words (uh, um, eh)" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Microphone" Style="{StaticResource SectionTitle}" />
                                <ComboBox ItemsSource="{Binding Microphones}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Microphone}" />
                                <CheckBox IsChecked="{Binding UseGpu}" Content="Use the graphics card for Whisper" Margin="0,14,0,0" />
                                <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start with Windows" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="History" Style="{StaticResource SectionTitle}" />
                                <CheckBox IsChecked="{Binding KeepHistory}" Content="Show a history of what you dictate" />
                                <TextBlock Style="{StaticResource Caption}" Margin="28,0,0,0"
                                           Text="The last 100 dictations appear on the Dictation page, newest on top, each with a copy button. They are kept in memory only: nothing is written to disk, and everything is gone when you quit Zeppie Says." />
                                <Button Content="Clear history" Command="{Binding ClearHistory}" IsEnabled="{Binding HasHistory}"
                                        HorizontalAlignment="Left" Margin="28,12,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Notetaker settings -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Notetaker}">
                            <StackPanel>
                                <TextBlock Text="Notetaker settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                           Text="These apply to the Notetaker page: transcribing audio and video files, and recording meetings. Dictation has its own model and language on the Dictation page." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Folder" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,7">
                                            <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                        </Border>
                                        <Button Grid.Column="1" Content="Change…" Command="{Binding ChooseFolder}" Margin="8,0,0,0" />
                                        <Button Grid.Column="2" Content="Open" Command="{Binding OpenFolder}" Margin="6,0,0,0" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,0"
                                               Text="Every audio or video file in this folder is transcribed. The transcript (.md) and the audio then move to Done." />

                                    <!-- Meetings -->
                                    <CheckBox Content="Ask when a meeting starts" IsChecked="{Binding AskToRecordMeetings}" Margin="0,14,0,0"
                                              ToolTip="When Teams, Zoom, Webex, Slack or Discord starts using your microphone" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="28,2,0,0"
                                               Text="Then records your microphone and the call separately, so you are always labelled right. Headphones keep the call out of your microphone. You can also record from the Notetaker page." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Model" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding DataContext.InstalledModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ModelId}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Language" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding DataContext.Languages, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}"
                                                      ToolTip="Whisper only; Parakeet detects the language itself" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <CheckBox Content="Label speakers" IsChecked="{Binding LabelSpeakers}" Margin="0,0,8,4"
                                                  ToolTip="Speaker 1, Speaker 2 per paragraph. Downloads two small models (33 MB) the first time." />
                                        <ComboBox ItemsSource="{x:Static ui:NotetakerViewModel.SpeakerCounts}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding Speakers}" MinWidth="104" Margin="0,0,20,4"
                                                  IsEnabled="{Binding LabelSpeakers}" VerticalAlignment="Center"
                                                  ToolTip="If you know how many people speak, pick it: speaker labels get much more reliable" />
                                        <CheckBox Content="Summary and action items" IsChecked="{Binding Summarize}" Margin="0,0,20,4"
                                                  ToolTip="Written by your default style model (Styles page)" />
                                        <CheckBox Content="Dictionary hints" IsChecked="{Binding UseDictionary}" Margin="0,0,0,4"
                                                  ToolTip="Gives your dictionary words to Whisper so names are spelled right" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <Expander Header="Speaker detection (advanced)" Margin="0,16,0,0">
                                <StackPanel Margin="0,12,0,4" MaxWidth="720" HorizontalAlignment="Left">
                                    <TextBlock Text="Voice model" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{x:Static ui:NotetakerViewModel.VoiceModels}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding VoiceModelChoice}" HorizontalAlignment="Left" MinWidth="260" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap" Text="{Binding VoiceModelNote}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="2,2,0,16" TextWrapping="Wrap"
                                               Text="Tells voices apart and recognises the people you named. After a switch, named voices are learned again from transcripts that still have their audio; the first file with a new model downloads it (about 30 MB)." />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                               Text="Every new file starts with these settings; change them per file before it starts, or afterwards with “Find the speakers again” above a transcript." />
                                    <ContentControl Content="{Binding SpeakerDetection}" ContentTemplate="{StaticResource SpeakerDetectionPanel}" Focusable="False" IsEnabled="{Binding UsesLocalVoiceModel}" />
                                </StackPanel>
                            </Expander>
                            </StackPanel>
                        </Border>
                        <!-- Known speakers: voices named in transcripts -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Speakers" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           Text="People whose voice Zeppie Says knows. Name a speaker under a transcript and later recordings label that voice for you. Only a voiceprint is kept, never audio." />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,0"
                                           Text="No one yet. Rename “Speaker 1” under a transcript on the Notetaker page to add someone."
                                           Visibility="{Binding NoKnownVoices, Converter={StaticResource Visible}}" />
                                <ItemsControl ItemsSource="{Binding KnownVoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:KnownVoiceRow}">
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6"
                                                    Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                               VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                    <!-- The tooltip also explains a greyed-out button -->
                                                    <Button Grid.Column="2" Content="{Binding PlayGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,5"
                                                            VerticalAlignment="Center" Margin="0,0,4,0" IsEnabled="{Binding CanPlay}"
                                                            ToolTip="{Binding PlayTip}" ToolTipService.ShowOnDisabled="True"
                                                            AutomationProperties.Name="Listen to this voice"
                                                            Command="{Binding DataContext.PlayVoice, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,5"
                                                            VerticalAlignment="Center" ToolTip="Forget this voice"
                                                            AutomationProperties.Name="Forget this voice"
                                                            Command="{Binding DataContext.ForgetVoice, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- AI providers: the models the styles rewrite with -->
                        <Border x:Name="AiProvidersCard" Style="{StaticResource Card}" DataContext="{Binding Styles}">
                            <StackPanel>
                                <TextBlock Text="AI providers" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap"
                                           Text="Where the AI models run: Ollama on this PC, and the cloud services with your keys. Which model each style uses is on the Styles page; the profile at the top left switches the models of all keys and styles at once." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Ollama on this PC -->
                                    <StackPanel>
                                        <TextBlock Text="Ollama address, on this PC" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding OllamaUrl, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Ollama address" />
                                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshOllama}" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding OllamaStatus}" Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Cloud keys -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="OpenAI API key" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <PasswordBox x:Name="OpenAiKeyBox" LostFocus="OpenAiKeyBox_LostFocus" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasOpenAiKey, Converter={StaticResource Visible}}">
                                            Key saved, encrypted for your Windows account. Type a new one to replace it, or
                                            <Hyperlink Click="RemoveOpenAiKey_Click">remove it</Hyperlink>.
                                        </TextBlock>

                                        <TextBlock Text="Anthropic (Claude) API key" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                                        <PasswordBox x:Name="AnthropicKeyBox" LostFocus="AnthropicKeyBox_LostFocus" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasAnthropicKey, Converter={StaticResource Visible}}">
                                            Key saved, encrypted for your Windows account. Type a new one to replace it, or
                                            <Hyperlink Click="RemoveAnthropicKey_Click">remove it</Hyperlink>.
                                        </TextBlock>

                                        <TextBlock Text="ElevenLabs API key" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                                        <PasswordBox x:Name="ElevenLabsKeyBox" LostFocus="ElevenLabsKeyBox_LostFocus" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasElevenLabsKey, Converter={StaticResource Visible}}">
                                            Key saved, encrypted for your Windows account. Type a new one to replace it, or
                                            <Hyperlink Click="RemoveElevenLabsKey_Click">remove it</Hyperlink>.
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" Margin="2,10,0,0" TextWrapping="Wrap"
                                                   Text="Keys stay on this PC, also when your settings folder is in OneDrive." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- Microsoft To Do, for keys that add a task -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Todo}">
                            <StackPanel>
                                <TextBlock Text="Microsoft To Do" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap"
                                           Text="For a key that adds a task (Keys page, What it does). ZeppieSays signs in with your Microsoft account through your own app registration; the sign-in stays on this PC, encrypted for your Windows account." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Application (client) ID" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Application (client) ID" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Directory (tenant) ID or domain" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Tenant, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Directory (tenant) ID or domain" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Sign in with Microsoft" Command="{Binding SignIn}" IsEnabled="{Binding CanSignIn}"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                    <Button Content="Sign out" Command="{Binding SignOut}" Margin="8,0,0,0"
                                            Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" />
                                <Expander Header="How to make the app registration (once)" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Margin="4,8,0,0" TextWrapping="Wrap" LineHeight="20">
                                        <Run Text="1. On entra.microsoft.com, open App registrations and choose New registration. Name it ZeppieSays; supported accounts: this organization only." /><LineBreak />
                                        <Run Text="2. Under Authentication, add a platform: Mobile and desktop applications (not Web), with the redirect URI http://localhost. Leave Allow public client flows off: the browser sign-in doesn't need it." /><LineBreak />
                                        <Run Text="3. Under API permissions, add Microsoft Graph, Delegated: Tasks.ReadWrite (User.Read is there already). If your organization asks for it, have an administrator grant consent." /><LineBreak />
                                        <Run Text="4. Copy the Application (client) ID and the Directory (tenant) ID from the Overview into the boxes above, and sign in." />
                                    </TextBlock>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <!-- Where the user's own data lives -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Settings folder" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,7">
                                        <TextBlock Text="{Binding SettingsFolder, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SettingsFolder, Mode=OneWay}" />
                                    </Border>
                                    <Button Grid.Column="1" Content="Change…" Command="{Binding ChooseSettingsFolder}" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Content="Open" Command="{Binding OpenSettingsFolder}" Margin="6,0,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0"
                                           Text="Your settings, dictionary, styles, dictation keys, named voices and stats. Put this in OneDrive to keep them after a reinstall and on your other PCs. API keys always stay on this PC. When two PCs change settings at the same moment, the last save wins." />
                                <TextBlock Margin="2,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsAreLocal}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Hyperlink Command="{Binding UseLocalSettings}">Keep settings on this PC only</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- Updates -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Updates}">
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                                <TextBlock>
                                    <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Check now" Command="{Binding CheckNow}" IsEnabled="{Binding CanCheck}" Margin="0,0,8,0" />
                                    <Button Content="Restart to update" Command="{Binding RestartToUpdate}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdateReady}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="4,0,4,12" Style="{StaticResource Caption}">
                            <Hyperlink Command="{Binding OpenDataFolder}">Open models and logs folder</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Insights: docked at the bottom, just above Settings -->
            <TabItem Header="Insights" Tag="&#xE9D9;" DockPanel.Dock="Bottom" x:Name="InsightsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,18,16" DataContext="{Binding Insights}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Words per minute -->
                            <Border Style="{StaticResource InsightCard}" Margin="0,0,10,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding Wpm}" Style="{StaticResource InsightNumber}" />
                                    <TextBlock Text="WORDS PER MINUTE" Style="{StaticResource InsightLabel}" />
                                    <Grid Width="150" Height="124" Margin="0,18,0,0" HorizontalAlignment="Center">
                                        <ui:ArcGauge Width="150" Height="150" VerticalAlignment="Top" Thickness="14"
                                                     Value="{Binding WpmGauge}" Fill="{StaticResource Accent}" Track="{StaticResource AccentSoft}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding FasterThanTyping}" FontSize="26" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" />
                                            <TextBlock Text="faster than typing" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Fixes -->
                            <Border Grid.Column="1" Style="{StaticResource InsightCard}" Margin="10,0,10,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding Fixes, StringFormat=N0}" Style="{StaticResource InsightNumber}" />
                                    <TextBlock Text="FIXES MADE" Style="{StaticResource InsightLabel}" />
                                    <Border Style="{StaticResource InsightRule}" />
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="15" />
                                                <Setter Property="Margin" Value="0,0,0,10" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <TextBlock><Run Text="{Binding FillerWords, Mode=OneWay}" FontWeight="SemiBold" /> filler words removed</TextBlock>
                                        <TextBlock><Run Text="{Binding DictionaryFixes, Mode=OneWay}" FontWeight="SemiBold" /> dictionary fixes</TextBlock>
                                        <TextBlock><Run Text="{Binding ScreenWords, Mode=OneWay}" FontWeight="SemiBold" /> names from your screen</TextBlock>
                                        <TextBlock><Run Text="{Binding Rewrites, Mode=OneWay}" FontWeight="SemiBold" /> style rewrites</TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Total words -->
                            <Border Grid.Column="2" Style="{StaticResource InsightCard}" Margin="10,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalWords, StringFormat=N0}" Style="{StaticResource InsightNumber}" />
                                    <TextBlock Text="TOTAL WORDS DICTATED" Style="{StaticResource InsightLabel}" />
                                    <Border Style="{StaticResource InsightRule}" />
                                    <TextBlock Text="{Binding Comparison}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeSaved}" FontSize="14" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Where you dictate -->
                            <Border Style="{StaticResource InsightCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="App usage" Style="{StaticResource InsightHeading}" />
                                    <TextBlock Text="{Binding AppsUsed}" Style="{StaticResource InsightLabel}" Margin="0,4,0,22" />
                                    <ItemsControl ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ui:CategoryRow}">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="{Binding BarWidth}" MinWidth="50" />
                                                        <ColumnDefinition Width="{Binding RestWidth}" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="20" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Height="38" CornerRadius="6" Background="{Binding BarBrush}">
                                                        <TextBlock Text="{Binding Percent}" Foreground="{Binding TextBrush}" FontWeight="Bold"
                                                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                               Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Streak -->
                            <Border Grid.Column="1" Style="{StaticResource InsightCard}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StreakTitle}" Style="{StaticResource InsightHeading}" />
                                    <TextBlock Text="{Binding LongestStreak}" Style="{StaticResource InsightLabel}" Margin="0,4,0,22" />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,22,8,0">
                                                <StackPanel.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                        <Setter Property="Height" Value="24" />
                                                        <Setter Property="Padding" Value="0,4,0,0" />
                                                    </Style>
                                                </StackPanel.Resources>
                                                <TextBlock Text="Mon" /><TextBlock Text="Tue" /><TextBlock Text="Wed" /><TextBlock Text="Thu" />
                                                <TextBlock Text="Fri" /><TextBlock Text="Sat" /><TextBlock Text="Sun" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Weeks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type ui:HeatmapWeek}">
                                                        <StackPanel Width="24">
                                                            <Canvas Height="22">
                                                                <TextBlock Text="{Binding Month}" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                                                            </Canvas>
                                                            <ItemsControl ItemsSource="{Binding Days}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type ui:HeatmapCell}">
                                                                        <Border Width="20" Height="20" Margin="2" CornerRadius="5"
                                                                                Background="{Binding Fill}" ToolTip="{Binding ToolTip}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Viewbox>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <TextBlock Text="Less" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ItemsControl ItemsSource="{Binding Legend}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="16" Height="16" Margin="2" CornerRadius="4" Background="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="More" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- The profile: which models the keys and styles use, switched all at once, on every page. Sits in the sidebar's room for it. -->
        <StackPanel x:Name="ProfilePicker" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Margin="24,112,0,0">
            <TextBlock Text="Profile" Style="{StaticResource Caption}" Margin="2,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberPath="Name"
                          AutomationProperties.Name="Profile"
                          ToolTip="Which models the dictation keys and the styles use" />
                <ToggleButton x:Name="ProfileMenuButton" Grid.Column="1" Margin="6,0,0,0" Padding="9,6"
                              AutomationProperties.Name="Manage profiles" ToolTip="New, rename or delete a profile"
                              IsChecked="{Binding IsOpen, ElementName=ProfileMenu}">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </ToggleButton>
                <Popup x:Name="ProfileMenu" PlacementTarget="{Binding ElementName=ProfileMenuButton}" Placement="Bottom"
                       HorizontalOffset="-200" StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource Card}" Width="260" Margin="0,6,0,0"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <StackPanel>
                            <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ActiveProfile.Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Profile name" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="New profile" Command="{Binding AddProfile}"
                                        ToolTip="A copy of this profile; change only what should differ" />
                                <Button Content="Delete" Command="{Binding DeleteProfile}" IsEnabled="{Binding CanDeleteProfile}"
                                        Margin="8,0,0,0" ToolTip="Removes this profile; the first one in the list takes over" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="A profile holds the speech model and language of every key, and the AI model of every style. What you change there is kept in the profile you're on." />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,4,4,0">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
            <Button Style="{StaticResource CaptionButton}" x:Name="MaximizeButton" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
